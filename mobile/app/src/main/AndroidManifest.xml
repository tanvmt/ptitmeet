        <activity android:name=".activities.MainActivity"/>
        <activity android:name=".activities.ProfileActivity" android:exported="false"/>
        <activity android:name=".activities.RecordingsActivity" android:exported="false"/>
        <activity android:name=".activities.MeetingActivity"/>
        <activity android:name=".activities.WaitingRoomActivity"/>
        <activity android:name=".activities.ScheduleMeetingActivity" android:exported="false"/>
        <activity android:name=".activities.MeetingsActivity" android:exported="false"/>
