PORT=8080

DB_URL=jdbc:mysql://your-mysql-host:3306/ptitmeet?ssl-mode=REQUIRED
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password

MONGO_URL=mongodb+srv://your_mongo_user:your_mongo_password@your-cluster.mongodb.net/ptitmeet_chat?retryWrites=true&w=majority

LIVEKIT_URL=https://your-livekit-host
LIVEKIT_WSURL=wss://your-livekit-ws-host
LIVEKIT_KEY=your_livekit_api_key
LIVEKIT_SECRET=your_livekit_api_secret

JWT_SECRET=replace_with_a_long_random_secret_at_least_32_bytes
GOOGLE_CLIENT_ID=your_google_oauth_client_id

MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password

FRONTEND_URL=https://meet.your-domain.com
CORS_ALLOWED_ORIGINS=https://meet.your-domain.com,https://www.meet.your-domain.com

S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_BUCKET=your_recording_bucket
S3_REGION=ap-southeast-1
S3_LIVEKIT_RECORD_DOMAIN=https://your-public-record-domain/

OTEL_SERVICE_NAME=ptitmeet-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://signoz-otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
